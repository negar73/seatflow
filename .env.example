# ---------------------------------------------------------------------------
# SeatFlow — example environment configuration
# Copy this file to `.env` and adjust the values for your machine.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# The `docker compose up -d` stack from this repo matches these defaults.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seatflow?schema=public"

# Redis connection string used by BullMQ (payment queue + hold-expiry queue).
REDIS_URL="redis://localhost:6379"

# Mock payment gateway behaviour:
#   false → 15% of payment attempts randomly fail (demonstrates retries +
#           the seat-release compensation path in the worker).
#   true  → every payment succeeds (handy for recorded demos).
FORCE_PAYMENT_SUCCESS="false"

# Optional: when set, POST /api/bookings/release-expired requires the
# `x-cron-secret` header to match this value. Leave unset in development.
# CRON_SECRET="change-me"
